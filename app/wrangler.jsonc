{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nokor-pass",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built PWA is served by the edge; /api/* falls through to the Worker.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nokor-pass",
      // Replace with the id from `wrangler d1 create nokor-pass` before deploying.
      "database_id": "85a665f6-b6c5-41ac-8f63-db2035a4a25b",
      "migrations_dir": "migrations"
    }
  ],
  // One relayer instance serialises the operator key's transactions (SPEC §9.4).
  "durable_objects": {
    "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relayer"] }],
  // Release escrowed payments whose hold has passed.
  "triggers": { "crons": ["* * * * *"] },
  // Local development defaults: an anvil chain on 127.0.0.1:8545 with the
  // contracts deployed by contracts/script/Deploy.s.sol. For Base Sepolia, set
  // RPC_URL, CHAIN_ID=84532, EXPLORER_URL and CONTRACTS from
  // contracts/deployments/84532.json (see README).
  "vars": {
    "RPC_URL": "https://sepolia.base.org",
    "CHAIN_ID": "84532",
    "EXPLORER_URL": "https://sepolia.basescan.org",
    "CONTRACTS": "{\n  \"chainId\": 84532,\n  \"NokorAccess\": \"0xd828882ae9e821d5908674100310BA83FF4E5F66\",\n  \"NokorPass\": \"0xaCB11053B3B74E060765Cb09d10f86DaF0Dc69dA\",\n  \"NokorPoint\": \"0xCB6D0e77618027348A9a3781DD0e91896B92eAC0\",\n  \"NokorRegistry\": \"0x311C8FCacbD18F3Db5f451AfbD955b7A7eB9C43C\",\n  \"kRIEL\": \"0x421528cE814D59Ed9Eae825bE7B5758A62A6bDF2\",\n  \"kUSD\": \"0x7b1864aaCD65a7eC834177818b05A5c2f0AAad1c\"\n}",
    "DISPUTE_WINDOW_SECONDS": "86400"
  },
  "observability": { "enabled": true }
}
